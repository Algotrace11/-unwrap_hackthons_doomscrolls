# Instagram Meta Graph API Credentials (for live publishing)
# When running locally, copy this file to .env and fill in your values.
# When running on GitHub Actions, add these as Repository Secrets.

INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
META_ACCESS_TOKEN=your_long_lived_user_or_page_access_token

# Optional: Cloudinary credentials for hosting image publicly for Meta API
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Fallback Imgur client ID
IMGUR_CLIENT_ID=your_imgur_client_id
